# Todo Web Application - Environment Variables
# Copy this file to .env and update the values for your environment

# ===========================
# Database Configuration
# ===========================
DATABASE_URL=postgresql://todo_user:todo_password@localhost:5432/todo_db
DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=30

# ===========================
# Security Configuration
# ===========================
SECRET_KEY=your-super-secret-key-change-in-production-please-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=24

# ===========================
# Environment Configuration
# ===========================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ===========================
# CORS Configuration
# ===========================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ===========================
# Redis Configuration
# ===========================
REDIS_URL=redis://localhost:6379

# ===========================
# Email Configuration (Optional)
# ===========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_NAME=Todo App

# ===========================
# Frontend Configuration
# ===========================
NEXT_PUBLIC_API_BASE_URL=http://localhost:7860
NEXT_PUBLIC_APP_NAME="Todo Web Application"
NEXT_PUBLIC_COMPANY_NAME="Todo App Inc."

# ===========================
# Backend Configuration
# ===========================
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3001", "http://127.0.0.1:3001"]'

# ===========================
# Rate Limiting
# ===========================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600  # in seconds

# ===========================
# AWS Configuration (Optional)
# ===========================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-todo-app-bucket
AWS_REGION=us-east-1

# ===========================
# Sentry Configuration (Optional)
# ===========================
SENTRY_DSN=your-sentry-dsn-if-using-sentry