# Frontend Environment Variables
# Copy this file to .env.local and update the values

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Environment
NODE_ENV=development

# Authentication
NEXT_PUBLIC_JWT_EXPIRY_TIME=30m
NEXT_PUBLIC_REFRESH_TOKEN_ENABLED=true

# UI Configuration
NEXT_PUBLIC_APP_NAME="Todo Web Application"
NEXT_PUBLIC_COMPANY_NAME="Todo App Inc."
NEXT_PUBLIC_SUPPORT_EMAIL=support@todoapp.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_ONBOARDING=true

# Third-party Integrations (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Upload Configuration (if using file uploads)
NEXT_PUBLIC_MAX_UPLOAD_SIZE=5242880  # 5MB in bytes
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/*,.pdf,.doc,.docx

# Theme Configuration
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_ENABLE_DARK_MODE=true